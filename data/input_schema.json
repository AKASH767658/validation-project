        }
      ]
    },
    {
      "field": "primaryResidenceRepaymentPeriodYears",
      "rules": [
        {
          "type": "min",
          "value": 1,
          "message": "Primary Residence Repayment Period Years must be greater than 0."
        },
        {
          "type": "max",
          "value": 40,
          "message": "Primary Residence Repayment Period Years cannot be greater than 40."
        }
      ]
    },
    {
