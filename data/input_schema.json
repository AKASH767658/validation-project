{
  "field_schema": [
    {
      "key": "planName",
      "label": "401(k) Plan Name",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "planNumber",
      "label": "401(k) Plan Number",
      "type": "text",
      "options": null,
      "format": "###"
    },
    {
      "key": "employerLegalName",
      "label": "Employer Legal Name",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "employerEin",
      "label": "Employer EIN",
      "type": "text",
      "options": null,
      "format": "##-#######"
    },
    {
      "key": "planEffectiveDate",
      "label": "Plan Effective Date",
      "type": "text",
      "options": null,
      "format": "MM/DD/YYYY"
    },
    {
      "key": "contributionType",
      "label": "Contribution Type",
      "type": "enum_single",
      "options": [
        "Traditional Pre-Tax",
        "Roth After-Tax",
        "Traditional and Roth",
        "Employer Only",
        "Safe Harbor"
      ],
      "format": null
    },
    {
      "key": "employeeContributionPercentage",
      "label": "Employee Contribution Percentage",
      "type": "text",
      "options": null,
      "format": "0.00%"
    },
    {
      "key": "employerMatchContributionPermitted",
      "label": "Employer Match Contribution Permitted",
      "type": "boolean",
      "options": [
        "Yes",
        "No"
      ],
      "format": null
    },
    {
      "key": "employerMatchContributionType",
      "label": "Employer Match Contribution Type",
      "type": "enum_single",
      "options": [
        "Discretionary",
        "Fixed",
        "Tiered",
        "Safe Harbor Match",
        "Other"
      ],
      "format": null
    },
    {
      "key": "employerMatchContributionTypeOther",
      "label": "Employer Match Contribution Type - Other",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "employerMatchContributionFormula",
      "label": "Employer Match Contribution Formula",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "employerMatchContributionMaximumDeferralPercent",
      "label": "Employer Match Contribution Maximum Deferral Percent",
      "type": "text",
      "options": null,
      "format": "0.00%"
    },
    {
      "key": "automaticEnrollmentType",
      "label": "Automatic Enrollment Type",
      "type": "enum_single",
      "options": [
        "None",
        "ACA",
        "EACA",
        "QACA"
      ],
      "format": null
    },
    {
      "key": "automaticEnrollmentDefaultPercent",
      "label": "Automatic Enrollment Default Percent",
      "type": "text",
      "options": null,
      "format": "0.00%"
    },
    {
      "key": "automaticEnrollmentAnnualIncreaseAllowed",
      "label": "Automatic Enrollment Annual Increase Allowed",
      "type": "boolean",
      "options": [
        "Yes",
        "No"
      ],
      "format": null
    },
    {
      "key": "automaticEnrollmentAnnualIncreasePercent",
      "label": "Automatic Enrollment Annual Increase Percent",
      "type": "text",
      "options": null,
      "format": "0.00%"
    },
    {
      "key": "automaticEnrollmentMaximumPercent",
      "label": "Automatic Enrollment Maximum Percent",
      "type": "text",
      "options": null,
      "format": "0.00%"
    },
    {
      "key": "automaticEnrollmentWithdrawalWindowDays",
      "label": "Automatic Enrollment Withdrawal Window Days",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "vestingSchedule",
      "label": "Vesting Schedule",
      "type": "enum_single",
      "options": [
        "Immediate Vesting",
        "3-Year Cliff",
        "6-Year Graded",
        "Custom Schedule"
      ],
      "format": null
    },
    {
      "key": "customVestingScheduleDetails",
      "label": "Custom Vesting Schedule Details",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "eligibilityRequirement",
      "label": "Eligibility Requirement",
      "type": "enum_single",
      "options": [
        "Immediate Eligibility",
        "30 Days of Service",
        "60 Days of Service",
        "90 Days of Service",
        "1 Year of Service",
        "Custom Eligibility"
      ],
      "format": null
    },
    {
      "key": "customEligibilityRequirementDetails",
      "label": "Custom Eligibility Requirement Details",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "permittedWithdrawalTypes",
      "label": "Permitted Withdrawal Types",
      "type": "enum_multi",
      "options": [
        "Hardship Withdrawal",
        "In-Service Withdrawal",
        "Required Minimum Distribution",
        "Rollover Withdrawal",
        "Termination Distribution"
      ],
      "format": null
    },
    {
      "key": "loansNumber",
      "label": "Loans - Number",
      "type": "enum_single",
      "options": [
        "None",
        "One",
        "Two",
        "Unlimited"
      ],
      "format": null
    },
    {
      "key": "loansFrequency",
      "label": "Loans - Frequency",
      "type": "enum_single",
      "options": [
        "One at a time",
        "One per calendar year",
        "One per plan year",
        "Unlimited"
      ],
      "format": null
    },
    {
      "key": "loansRestrictions",
      "label": "Loans - Restrictions",
      "type": "enum_multi",
      "options": [
        "General Purpose Loans",
        "Primary Residence Loans",
        "Hardship Loans Only",
        "Participant Directed Accounts Only",
        "Other"
      ],
      "format": null
    },
    {
      "key": "loansRestrictionsOther",
      "label": "Loans - Restrictions - Other",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "loansMinimum",
      "label": "Loans - Minimum",
      "type": "text",
      "options": null,
      "format": "$0.00"
    },
    {
      "key": "loansMaximum",
      "label": "Loans - Maximum",
      "type": "text",
      "options": null,
      "format": "$0.00"
    },
    {
      "key": "loansRate",
      "label": "Loans - Rate",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "loansRepaymentPeriodYears",
      "label": "Loans - Repayment Period Years",
      "type": "text",
      "options": null,
      "format": null
    },
    {
      "key": "loansHardshipOnly",
      "label": "Loans - Hardship Only",
      "type": "boolean",
      "options": [
        "Yes",
        "No"
      ],
      "format": null
    }
  ],
  "dependency_rules": [
    {
      "id": "employer-match-dependent-fields",
      "description": "Employer match fields are shown and required when employer match is permitted.",
      "when": {
        "field": "employerMatchContributionPermitted",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        },
        {
          "action": "require",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionFormula"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionTypeOther",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionTypeOther",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        }
      ],
      "messages": {
        "employerMatchContributionType": "Employer Match Contribution Type is required when employer match is permitted.",
        "employerMatchContributionFormula": "Employer Match Contribution Formula is required when employer match is permitted."
      }
    },
    {
      "id": "employer-match-type-other-dependent-field",
      "description": "Other match type details are required when match type is Other.",
      "when": {
        "field": "employerMatchContributionType",
        "operator": "equals",
        "value": "Other"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        },
        {
          "action": "require",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        }
      ],
      "messages": {
        "employerMatchContributionTypeOther": "Other match type details are required when Employer Match Contribution Type is Other."
      }
    },
    {
      "id": "automatic-enrollment-dependent-fields",
      "description": "Automatic enrollment fields are shown when automatic enrollment is enabled.",
      "when": {
        "field": "automaticEnrollmentType",
        "operator": "notEquals",
        "value": "None"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed",
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent",
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed",
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent",
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ]
    },
    {
      "id": "automatic-enrollment-annual-increase-dependent-fields",
      "description": "Annual increase values are required when annual increase is allowed.",
      "when": {
        "field": "automaticEnrollmentAnnualIncreaseAllowed",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        }
      ]
    },
    {
      "id": "eaca-qaca-withdrawal-window-dependent-field",
      "description": "Withdrawal window days are required for EACA and QACA.",
      "when": {
        "field": "automaticEnrollmentType",
        "operator": "in",
        "value": [
          "EACA",
          "QACA"
        ]
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ]
    },
    {
      "id": "custom-vesting-requires-details",
      "description": "Custom vesting details are required for a custom schedule.",
      "when": {
        "field": "vestingSchedule",
        "operator": "equals",
        "value": "Custom Schedule"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "customVestingScheduleDetails"
          ]
        },
        {
          "action": "require",
          "fields": [
            "customVestingScheduleDetails"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "customVestingScheduleDetails"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "customVestingScheduleDetails"
          ]
        }
      ]
    },
    {
      "id": "custom-eligibility-requires-details",
      "description": "Custom eligibility details are required for custom eligibility.",
      "when": {
        "field": "eligibilityRequirement",
        "operator": "equals",
        "value": "Custom Eligibility"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "customEligibilityRequirementDetails"
          ]
        },
        {
          "action": "require",
          "fields": [
            "customEligibilityRequirementDetails"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "customEligibilityRequirementDetails"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "customEligibilityRequirementDetails"
          ]
        }
      ]
    },
    {
      "id": "loans-dependent-fields",
      "description": "Loan fields are hidden and cleared when Loans - Number is None.",
      "when": {
        "field": "loansNumber",
        "operator": "in",
        "value": [
          "None",
          null
        ]
      },
      "then": [
        {
          "action": "hide",
          "fields": [
            "loansFrequency",
            "loansRestrictions",
            "loansRestrictionsOther",
            "loansMinimum",
            "loansMaximum",
            "loansRate",
            "loansRepaymentPeriodYears",
            "loansHardshipOnly"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "loansFrequency",
            "loansRestrictions",
            "loansRestrictionsOther",
            "loansMinimum",
            "loansMaximum",
            "loansRate",
            "loansRepaymentPeriodYears",
            "loansHardshipOnly"
          ]
        }
      ],
      "else": [
        {
          "action": "show",
          "fields": [
            "loansFrequency",
            "loansRestrictions",
            "loansMinimum",
            "loansMaximum",
            "loansRate",
            "loansRepaymentPeriodYears",
            "loansHardshipOnly"
          ]
        },
        {
          "action": "require",
          "fields": [
            "loansFrequency",
            "loansMinimum",
            "loansMaximum",
            "loansRate",
            "loansRepaymentPeriodYears",
            "loansHardshipOnly"
          ]
        }
      ]
    },
    {
      "id": "loans-restrictions-other-dependent-field",
      "description": "Other loan restriction details are required when Other is selected.",
      "when": {
        "field": "loansRestrictions",
        "operator": "contains",
        "value": "Other"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "loansRestrictionsOther"
          ]
        },
        {
          "action": "require",
          "fields": [
            "loansRestrictionsOther"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "loansRestrictionsOther"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "loansRestrictionsOther"
          ]
        }
      ]
    }
  ],
  "validation_rules": [
    {
      "field": "planNumber",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{3}$",
          "message": "Plan Number must be 3 digits."
        }
      ]
    },
    {
      "field": "employerEin",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{2}-\\d{7}$",
          "message": "Employer EIN must be in ##-####### format."
        }
      ]
    },
    {
      "field": "planEffectiveDate",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{1,2}/\\d{1,2}/\\d{4}$",
          "message": "Plan Effective Date must be in MM/DD/YYYY format."
        }
      ]
    },
    {
      "field": "employeeContributionPercentage",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Employee Contribution Percentage cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Employee Contribution Percentage cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "employerMatchContributionTypeOther",
      "rules": [
        {
          "type": "maxLength",
          "value": 500,
          "message": "Employer Match Contribution Type - Other cannot exceed 500 characters."
        }
      ]
    },
    {
      "field": "employerMatchContributionFormula",
      "rules": [
        {
          "type": "maxLength",
          "value": 1000,
          "message": "Employer Match Contribution Formula cannot exceed 1000 characters."
        }
      ]
    },
    {
      "field": "employerMatchContributionMaximumDeferralPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Employer Match Contribution Maximum Deferral Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Employer Match Contribution Maximum Deferral Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentDefaultPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Default Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Default Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentAnnualIncreasePercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Annual Increase Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Annual Increase Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentMaximumPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Maximum Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Maximum Percent cannot be greater than 100%."
        },
        {
          "type": "greaterThanOrEqualToField",
          "value": "automaticEnrollmentDefaultPercent",
          "message": "Automatic Enrollment Maximum Percent must be greater than or equal to Automatic Enrollment Default Percent."
        }
      ]
    },
    {
      "field": "automaticEnrollmentWithdrawalWindowDays",
      "rules": [
        {
          "type": "min",
          "value": 1,
          "message": "Automatic Enrollment Withdrawal Window Days must be greater than 0."
        },
        {
          "type": "max",
          "value": 90,
          "message": "Automatic Enrollment Withdrawal Window Days cannot be greater than 90."
        }
      ]
    },
    {
      "field": "customVestingScheduleDetails",
      "rules": [
        {
          "type": "maxLength",
          "value": 500,
          "message": "Custom Vesting Schedule Details cannot exceed 500 characters."
        }
      ]
    },
    {
      "field": "customEligibilityRequirementDetails",
      "rules": [
        {
          "type": "maxLength",
          "value": 500,
          "message": "Custom Eligibility Requirement Details cannot exceed 500 characters."
        }
      ]
    },
    {
      "field": "loansRestrictions",
      "rules": [
        {
          "type": "mutuallyExclusive",
          "value": {
            "exclusive_value": "Hardship Loans Only"
          },
          "message": "Loans - Restrictions cannot include Hardship Loans Only with other restrictions."
        }
      ]
    },
    {
      "field": "loansRestrictionsOther",
      "rules": [
        {
          "type": "maxLength",
          "value": 500,
          "message": "Loans - Restrictions - Other cannot exceed 500 characters."
        }
      ]
    },
    {
      "field": "loansMinimum",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\$?\\d+(\\.\\d{2})?$",
          "message": "Loans - Minimum must be a valid currency amount."
        },
        {
          "type": "min",
          "value": 0,
          "message": "Loans - Minimum cannot be less than 0."
        }
      ]
    },
    {
      "field": "loansMaximum",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\$?\\d+(\\.\\d{2})?$",
          "message": "Loans - Maximum must be a valid currency amount."
        },
        {
          "type": "min",
          "value": 0,
          "message": "Loans - Maximum cannot be less than 0."
        },
        {
          "type": "greaterThanOrEqualToField",
          "value": "loansMinimum",
          "message": "Loans - Maximum must be greater than or equal to Loans - Minimum."
        }
      ]
    },
    {
      "field": "loansRate",
      "rules": [
        {
          "type": "maxLength",
          "value": 250,
          "message": "Loans - Rate cannot exceed 250 characters."
        }
      ]
    },
    {
      "field": "loansRepaymentPeriodYears",
      "rules": [
        {
          "type": "min",
          "value": 1,
          "message": "Loans - Repayment Period Years must be greater than 0."
        },
        {
          "type": "max",
          "value": 30,
          "message": "Loans - Repayment Period Years cannot be greater than 30."
        }
      ]
    }
  ]
}