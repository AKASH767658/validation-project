  "validation_rules": [
    {
      "field": "planNumber",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{3}$",
          "message": "Plan Number must be 3 digits."
        }
      ]
    },
    {
      "field": "employerEin",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{2}-\\d{7}$",
          "message": "Employer EIN must be in ##-####### format."
        }
      ]
    },
    {
      "field": "planEffectiveDate",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{1,2}/\\d{1,2}/\\d{4}$",
          "message": "Plan Effective Date must be in MM/DD/YYYY format."
        }
      ]
    },
    {
      "field": "rothEffectiveDate",
      "rules": [
        {
          "type": "pattern",
          "value": "^\\d{1,2}/\\d{1,2}/\\d{4}$",
          "message": "Roth Effective Date must be in MM/DD/YYYY format."
        }
      ]
    },
    {
      "field": "employeeContributionPercentage",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Employee Contribution Percentage cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Employee Contribution Percentage cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "employerMatchContributionMaximumDeferralPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Employer Match Contribution Maximum Deferral Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Employer Match Contribution Maximum Deferral Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentDefaultPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Default Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Default Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentAnnualIncreasePercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Annual Increase Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Annual Increase Percent cannot be greater than 100%."
        }
      ]
    },
    {
      "field": "automaticEnrollmentMaximumPercent",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Automatic Enrollment Maximum Percent cannot be less than 0%."
        },
        {
          "type": "max",
          "value": 100,
          "message": "Automatic Enrollment Maximum Percent cannot be greater than 100%."
        },
        {
          "type": "greaterThanOrEqualToField",
          "value": "automaticEnrollmentDefaultPercent",
          "message": "Automatic Enrollment Maximum Percent must be greater than or equal to Automatic Enrollment Default Percent."
        }
      ]
    },
    {
      "field": "automaticEnrollmentWithdrawalWindowDays",
      "rules": [
        {
          "type": "min",
          "value": 1,
          "message": "Automatic Enrollment Withdrawal Window Days must be greater than 0."
        },
        {
          "type": "max",
          "value": 90,
          "message": "Automatic Enrollment Withdrawal Window Days cannot be greater than 90."
        }
      ]
    },
    {
      "field": "minimumAgeRequirement",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Minimum Age Requirement cannot be less than 0."
        },
        {
          "type": "max",
          "value": 99,
          "message": "Minimum Age Requirement cannot be greater than 99."
        }
      ]
    },
    {
      "field": "inServiceWithdrawalMinimumAge",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "In-Service Withdrawal Minimum Age cannot be less than 0."
        },
        {
          "type": "max",
          "value": 99,
          "message": "In-Service Withdrawal Minimum Age cannot be greater than 99."
        }
      ]
    },
    {
      "field": "catchUpEligibilityAge",
      "rules": [
        {
          "type": "min",
          "value": 0,
          "message": "Catch-Up Eligibility Age cannot be less than 0."
        },
        {
          "type": "max",
          "value": 99,
          "message": "Catch-Up Eligibility Age cannot be greater than 99."
        }
      ]
    },
