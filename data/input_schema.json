  "dependency_rules": [
    {
      "id": "controlled-group-details",
      "description": "Controlled group details are required when the employer is a controlled group member.",
      "when": {
        "field": "controlledGroupMember",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "controlledGroupDetails"
          ]
        },
        {
          "action": "require",
          "fields": [
            "controlledGroupDetails"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "controlledGroupDetails"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "controlledGroupDetails"
          ]
        }
      ],
      "messages": {
        "controlledGroupDetails": "Controlled Group Details are required when Controlled Group Member is Yes."
      }
    },
    {
      "id": "employee-contribution-details",
      "description": "Contribution details are required when employee contributions are allowed.",
      "when": {
        "field": "employeeContributionAllowed",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "contributionType",
            "employeeContributionPercentage"
          ]
        },
        {
          "action": "require",
          "fields": [
            "contributionType",
            "employeeContributionPercentage"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "contributionType",
            "employeeContributionPercentage"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "contributionType",
            "employeeContributionPercentage"
          ]
        }
      ],
      "messages": {
        "contributionType": "Contribution Type is required when employee contributions are allowed.",
        "employeeContributionPercentage": "Employee Contribution Percentage is required when employee contributions are allowed."
      }
    },
    {
      "id": "employer-match-details",
      "description": "Employer match fields are required when employer match is permitted.",
      "when": {
        "field": "employerMatchContributionPermitted",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        },
        {
          "action": "require",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionFormula"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionTypeOther",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "employerMatchContributionType",
            "employerMatchContributionTypeOther",
            "employerMatchContributionFormula",
            "employerMatchContributionMaximumDeferralPercent"
          ]
        }
      ],
      "messages": {
        "employerMatchContributionType": "Employer Match Contribution Type is required when employer match is permitted.",
        "employerMatchContributionFormula": "Employer Match Contribution Formula is required when employer match is permitted."
      }
    },
    {
      "id": "employer-match-other",
      "description": "Other match details are required when match type is Other.",
      "when": {
        "field": "employerMatchContributionType",
        "operator": "equals",
        "value": "Other"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        },
        {
          "action": "require",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "employerMatchContributionTypeOther"
          ]
        }
      ],
      "messages": {
        "employerMatchContributionTypeOther": "Other match type details are required when Employer Match Contribution Type is Other."
      }
    },
    {
      "id": "profit-sharing-formula",
      "description": "Profit sharing formula is required when profit sharing is permitted.",
      "when": {
        "field": "profitSharingPermitted",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "profitSharingFormula"
          ]
        },
        {
          "action": "require",
          "fields": [
            "profitSharingFormula"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "profitSharingFormula"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "profitSharingFormula"
          ]
        }
      ],
      "messages": {
        "profitSharingFormula": "Profit Sharing Formula is required when profit sharing is permitted."
      }
    },
    {
      "id": "automatic-enrollment-details",
      "description": "Automatic enrollment fields are required when enrollment type is not None.",
      "when": {
        "field": "automaticEnrollmentType",
        "operator": "notEquals",
        "value": "None"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed",
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent",
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        },
        {
          "action": "clearValue",
          "fields": [
            "automaticEnrollmentDefaultPercent",
            "automaticEnrollmentAnnualIncreaseAllowed",
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent",
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ],
      "messages": {
        "automaticEnrollmentDefaultPercent": "Automatic Enrollment Default Percent is required when automatic enrollment is enabled.",
        "automaticEnrollmentAnnualIncreaseAllowed": "Automatic Enrollment Annual Increase Allowed is required when automatic enrollment is enabled."
      }
    },
    {
      "id": "annual-increase-details",
      "description": "Annual increase fields are required when annual increase is allowed.",
      "when": {
        "field": "automaticEnrollmentAnnualIncreaseAllowed",
        "operator": "equals",
        "value": "Yes"
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
          "fields": [
            "automaticEnrollmentAnnualIncreasePercent",
            "automaticEnrollmentMaximumPercent"
          ]
        },
        {
          "action": "clearValue",
