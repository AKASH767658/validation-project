            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ],
      "messages": {
        "automaticEnrollmentWithdrawalWindowDays": "Automatic Enrollment Withdrawal Window Days is required for EACA or QACA."
      }
    },
    {
      "id": "custom-eligibility",
      "description": "Custom eligibility details are required for custom eligibility.",
      "when": {
