            "automaticEnrollmentMaximumPercent"
          ]
        }
      ],
      "messages": {
        "automaticEnrollmentAnnualIncreasePercent": "Automatic Enrollment Annual Increase Percent is required when annual increase is allowed.",
        "automaticEnrollmentMaximumPercent": "Automatic Enrollment Maximum Percent is required when annual increase is allowed."
      }
    },
    {
      "id": "withdrawal-window",
      "description": "Withdrawal window is required for EACA or QACA.",
      "when": {
        "field": "automaticEnrollmentType",
        "operator": "in",
        "value": [
          "EACA",
          "QACA"
        ]
      },
      "then": [
        {
          "action": "show",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        },
        {
          "action": "require",
          "fields": [
            "automaticEnrollmentWithdrawalWindowDays"
          ]
        }
      ],
      "else": [
        {
          "action": "hide",
